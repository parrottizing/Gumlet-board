{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gumlet-board.local/docs/protocol/v1/payload.set_image.schema.json",
  "title": "LAN Clipboard Protocol v1 set_image payload (v2 reserved)",
  "type": "object",
  "required": [
    "mime_type",
    "byte_size",
    "data_base64",
    "width",
    "height",
    "orientation"
  ],
  "properties": {
    "mime_type": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ]
    },
    "byte_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "data_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 13981016,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "contentEncoding": "base64"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "orientation": {
      "type": "integer",
      "enum": [
        0,
        90,
        180,
        270
      ]
    }
  },
  "additionalProperties": true
}
