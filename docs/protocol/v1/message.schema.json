{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gumlet-board.local/docs/protocol/v1/message.schema.json",
  "title": "LAN Clipboard Protocol v1 Message",
  "type": "object",
  "$defs": {
    "baseEnvelope": {
      "type": "object",
      "required": [
        "protocol_version",
        "device_id",
        "event_id",
        "source",
        "event_type",
        "created_at_ms",
        "payload_hash",
        "payload"
      ],
      "properties": {
        "protocol_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "device_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "event_id": {
          "type": "string",
          "minLength": 12,
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "enum": [
            "android",
            "mac"
          ]
        },
        "event_type": {
          "type": "string",
          "enum": [
            "set_text",
            "set_image",
            "ack",
            "error",
            "ping",
            "pong"
          ]
        },
        "created_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "setTextPayload": {
      "type": "object",
      "required": [
        "mime_type",
        "text"
      ],
      "properties": {
        "mime_type": {
          "const": "text/plain"
        },
        "text": {
          "type": "string",
          "maxLength": 262144
        },
        "is_sensitive": {
          "type": "boolean",
          "default": false
        },
        "label": {
          "type": "string",
          "maxLength": 128
        }
      },
      "additionalProperties": true
    },
    "setImagePayload": {
      "type": "object",
      "required": [
        "mime_type",
        "byte_size",
        "data_base64",
        "width",
        "height",
        "orientation"
      ],
      "properties": {
        "mime_type": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "data_base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 13981016,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "contentEncoding": "base64"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "orientation": {
          "type": "integer",
          "enum": [
            0,
            90,
            180,
            270
          ]
        }
      },
      "additionalProperties": true
    },
    "ackPayload": {
      "type": "object",
      "required": [
        "acked_event_id",
        "status"
      ],
      "properties": {
        "acked_event_id": {
          "type": "string",
          "minLength": 12,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "duplicate",
            "rejected"
          ]
        },
        "error_code": {
          "type": "string"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error_code"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "errorPayload": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "AUTH_FAILURE",
            "PAYLOAD_TOO_LARGE",
            "UNSUPPORTED_TYPE",
            "STALE_EVENT",
            "BAD_MESSAGE",
            "HASH_MISMATCH",
            "VERSION_MISMATCH",
            "TEMPORARY_UNAVAILABLE"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 0
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "pingPongPayload": {
      "type": "object",
      "properties": {
        "nonce": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        }
      },
      "required": [
        "nonce"
      ],
      "additionalProperties": true
    }
  },
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "set_text"
            },
            "payload": {
              "$ref": "#/$defs/setTextPayload"
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "set_image"
            },
            "payload": {
              "$ref": "#/$defs/setImagePayload"
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "ack"
            },
            "payload": {
              "$ref": "#/$defs/ackPayload"
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "error"
            },
            "payload": {
              "$ref": "#/$defs/errorPayload"
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "ping"
            },
            "payload": {
              "$ref": "#/$defs/pingPongPayload"
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/baseEnvelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "pong"
            },
            "payload": {
              "$ref": "#/$defs/pingPongPayload"
            }
          }
        }
      ]
    }
  ]
}
